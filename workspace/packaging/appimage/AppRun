#!/usr/bin/env bash

set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export APPDIR="$HERE"

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE_ROOT="$DATA_HOME/gowin-ide-appimage"
RUNTIME_ID=$(printf '%s' "$APPDIR" | sha256sum | cut -c1-16)
RUNTIME_ROOT="$STATE_ROOT/runtimes/$RUNTIME_ID"
RUNTIME_USR="$RUNTIME_ROOT/usr"
STAMP_FILE="$RUNTIME_ROOT/.appdir-stamp"
LOCK_DIR="$RUNTIME_ROOT/.rebuild-lock"
CURRENT_STAMP=$(sha256sum "$APPDIR/AppRun" "$APPDIR/usr/bin/gw_ide" "$APPDIR/usr/bin/gw_sh" "$APPDIR/Programmer/bin/programmer" | sha256sum | cut -d' ' -f1)
export USER="${USER:-$(id -un)}"
export LOGNAME="${LOGNAME:-$USER}"
STATE_LICENSE="$STATE_ROOT/gwlicense.ini"

mkdir -p "$RUNTIME_ROOT" "$STATE_ROOT"

if [[ "${1:-}" == "--install-programmer-udev-rules" ]]; then
  exec "$APPDIR/usr/bin/install-programmer-udev-rules.sh"
fi

ENTRYPOINT="gw_ide"
if [[ "${1:-}" == "--gw_sh" || "${1:-}" == "gw_sh" ]]; then
  ENTRYPOINT="gw_sh"
  shift
fi

rebuild_runtime_bin() {
  if [[ ! -f "$STATE_LICENSE" ]]; then
    if [[ -f "$RUNTIME_USR/bin/gwlicense.ini" ]]; then
      cp -a "$RUNTIME_USR/bin/gwlicense.ini" "$STATE_LICENSE"
    elif [[ -f "$STATE_ROOT/usr/bin/gwlicense.ini" ]]; then
      cp -a "$STATE_ROOT/usr/bin/gwlicense.ini" "$STATE_LICENSE"
    elif [[ -f "$APPDIR/usr/bin/gwlicense.ini" ]]; then
      cp -a "$APPDIR/usr/bin/gwlicense.ini" "$STATE_LICENSE"
    fi
  fi

  rm -rf "$RUNTIME_USR"
  mkdir -p "$RUNTIME_USR"
  cp -a "$APPDIR/usr/bin" "$RUNTIME_USR/"

  ln -s "$APPDIR/usr/lib" "$RUNTIME_USR/lib"
  ln -s "$APPDIR/usr/plugins" "$RUNTIME_USR/plugins"
  ln -s "$APPDIR/usr/data" "$RUNTIME_USR/data"
  ln -s "$APPDIR/usr/doc" "$RUNTIME_USR/doc"
  ln -s "$APPDIR/usr/ipcore" "$RUNTIME_USR/ipcore"
  ln -s "$APPDIR/usr/share" "$RUNTIME_USR/share"
  ln -s "$APPDIR/usr/simlib" "$RUNTIME_USR/simlib"
  ln -s "$APPDIR/usr/translations" "$RUNTIME_USR/translations"
  ln -sfn "$RUNTIME_USR/data" "$RUNTIME_ROOT/data"
  ln -sfn "$RUNTIME_USR/translations" "$RUNTIME_ROOT/translations"
  rm -rf "$RUNTIME_ROOT/Programmer" "$RUNTIME_ROOT/Progmmer"
  cp -a "$APPDIR/Programmer" "$RUNTIME_ROOT/"
  ln -s "Programmer" "$RUNTIME_ROOT/Progmmer"

  if [[ -f "$STATE_LICENSE" ]]; then
    ln -sfn "$STATE_LICENSE" "$RUNTIME_USR/bin/gwlicense.ini"
  fi

  printf '%s\n' "$CURRENT_STAMP" > "$STAMP_FILE"
}

while ! mkdir "$LOCK_DIR" 2>/dev/null; do
  sleep 0.1
done
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT

if [[ ! -f "$STAMP_FILE" ]] || [[ "$(<"$STAMP_FILE")" != "$CURRENT_STAMP" ]] || [[ ! -x "$RUNTIME_USR/bin/gw_ide" ]] || [[ ! -x "$RUNTIME_USR/bin/gw_sh" ]] || [[ "$(readlink "$RUNTIME_USR/lib" 2>/dev/null || true)" != "$APPDIR/usr/lib" ]] || [[ ! -e "$RUNTIME_USR/lib/libQt5Core.so.5" ]] || [[ -L "$RUNTIME_ROOT/Programmer" ]] || [[ ! -x "$RUNTIME_ROOT/Programmer/bin/programmer" ]] || [[ ! -x "$RUNTIME_ROOT/Programmer/bin/programmer.real" ]] || [[ ! -x "$RUNTIME_ROOT/Progmmer/bin/programmer" ]]; then
  rebuild_runtime_bin
fi

rmdir "$LOCK_DIR"
trap - EXIT

export PATH="$RUNTIME_USR/bin:${PATH:-}"
export LD_LIBRARY_PATH="$RUNTIME_USR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$RUNTIME_USR/plugins/qt${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
export QT_QPA_PLATFORM_PLUGIN_PATH="$RUNTIME_USR/plugins/qt/platforms"
export QML2_IMPORT_PATH="$RUNTIME_USR/plugins/qt/qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
export XDG_DATA_DIRS="$RUNTIME_USR/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export QT_XCB_GL_INTEGRATION="${QT_XCB_GL_INTEGRATION:-xcb_glx}"
export QT_OPENGL="${QT_OPENGL:-desktop}"
export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-0}"
export QTWEBENGINE_DISABLE_SANDBOX="${QTWEBENGINE_DISABLE_SANDBOX:-1}"
export QTWEBENGINEPROCESS_PATH="$RUNTIME_USR/bin/QtWebEngineProcess"
export QTWEBENGINE_RESOURCES_PATH="$RUNTIME_USR/bin/resources"
export QTWEBENGINE_LOCALES_PATH="$RUNTIME_USR/bin/translations"
export GOWIN_ICUDTL_PATH="$RUNTIME_USR/bin/resources/icudtl.dat"
export ICU_DATA="$RUNTIME_USR/bin/resources"
CHROMIUM_FLAGS="--icu-data-file-path=$RUNTIME_USR/bin/resources/icudtl.dat --resources-dir-path=$RUNTIME_USR/bin/resources"
export QTWEBENGINE_CHROMIUM_FLAGS="$CHROMIUM_FLAGS${QTWEBENGINE_CHROMIUM_FLAGS:+ $QTWEBENGINE_CHROMIUM_FLAGS}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

mkdir -p "$RUNTIME_ROOT/places"
add_place() {
  local name="$1"
  local path="$2"

  if [[ -e "$path" ]]; then
    ln -sfn "$path" "$RUNTIME_ROOT/places/$name"
  fi
}

add_place home-mnt "$HOME/mnt"
add_place nextcloud "$HOME/mnt/nextcloud"
add_place seadrive-root "$HOME/mnt/seadrive-root"
add_place gvfs "/run/user/$(id -u)/gvfs"
add_place gvfs-metadata "$HOME/.local/share/gvfs-metadata"
add_place run-media "/run/media/$USER"
add_place media /media
add_place mnt /mnt

ARGS=()
for arg in "$@"; do
  if [[ "$arg" != -* && -e "$arg" ]]; then
    ARGS+=("$(realpath "$arg")")
  else
    ARGS+=("$arg")
  fi
done

install_webengine_compat_links() {
  local dir
  local file

  for dir in "$HOME/.IDE" "$HOME/.QtWebEngineProcess"; do
    mkdir -p "$dir"
    for file in icudtl.dat qtwebengine_resources.pak qtwebengine_resources_100p.pak qtwebengine_resources_200p.pak qtwebengine_devtools_resources.pak; do
      if [[ -L "$dir/$file" || ! -e "$dir/$file" ]]; then
        ln -sfn "$RUNTIME_USR/bin/resources/$file" "$dir/$file"
      fi
    done
    if [[ -L "$dir/qtwebengine_locales" || ! -e "$dir/qtwebengine_locales" ]]; then
      ln -sfn "$RUNTIME_USR/bin/translations/qtwebengine_locales" "$dir/qtwebengine_locales"
    fi
  done
}

install_webengine_compat_links

# Keep a few graphics/font libraries on the host to avoid ABI mismatches with
# newer systems while still using the bundled application-specific stack.
unset LD_PRELOAD
export LD_PRELOAD="$RUNTIME_USR/lib/libgowin-qputenv-keep-xcbgl.so"

cd "$RUNTIME_USR/bin"
exec "$RUNTIME_USR/bin/$ENTRYPOINT" "${ARGS[@]}"
